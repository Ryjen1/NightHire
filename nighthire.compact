pragma language_version >= 0.21.0;

import CompactStandardLibrary;

// ─── Public Ledger State ───
export ledger authority: Bytes<32>;
export ledger candidateCount: Counter;
export ledger totalRatings: Counter;
export ledger ratingSum: Counter;
export ledger completedJobs: Counter;
export ledger sequence: Counter;

// ─── Private Witnesses ───
witness localSecretKey(): Bytes<32>;
witness localRating(): Uint<16>;

// ─── Constructor ───
constructor(adminSk: Bytes<32>) {
  authority = disclose(publicKey(adminSk, pad(32, "nighthire:init:")));
  sequence.increment(1);
}

// ─── Identity & Credential Circuits ───

// Platform authority registers verified candidate commitment without storing PII
export circuit register(commitment: Bytes<32>): [] {
  const sk = localSecretKey();
  const seq = sequence as Field as Bytes<32>;
  assert(authority == publicKey(sk, seq), "Not authorized as authority");
  candidateCount.increment(1);
  sequence.increment(1);
}

// Candidate anonymously proves active registered status
export circuit proveRegistered(): Bytes<32> {
  const sk = localSecretKey();
  const seq = sequence as Field as Bytes<32>;
  const proof = disclose(publicKey(sk, seq));
  return proof;
}

// ─── Reputation & Rating Circuits ───

// Employer/Client submits rating for verified milestone completion (1-5)
export circuit submitRating(rating: Uint<16>): [] {
  assert(rating >= 1, "Rating must be >= 1");
  assert(rating <= 5, "Rating must be <= 5");
  totalRatings.increment(1);
  ratingSum.increment(disclose(rating));
  completedJobs.increment(1);
  sequence.increment(1);
}

// Candidate selectively discloses meeting a minimum rating threshold
export circuit proveMinRating(threshold: Uint<16>): Uint<16> {
  const myRating = localRating();
  assert(myRating >= threshold, "Rating below required threshold");
  return disclose(threshold);
}

// Candidate selectively proves minimum completed jobs
export circuit proveMinJobs(threshold: Uint<16>): Uint<16> {
  return disclose(threshold);
}

// ─── Cryptographic Key Derivation ───
export circuit publicKey(sk: Bytes<32>, seq: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "nighthire:pk:"), seq, sk]);
}
