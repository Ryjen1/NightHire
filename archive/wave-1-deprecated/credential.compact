pragma language_version >= 0.21.0;

import CompactStandardLibrary;

// Public Ledger State
export ledger authority: Bytes<32>;
export ledger candidateCount: Counter;
export ledger sequence: Counter;

// Private Witnesses
witness localSecretKey(): Bytes<32>;

// Constructor to initialize contract authority
constructor(adminSk: Bytes<32>) {
  authority = disclose(publicKey(adminSk, pad(32, "nighthire:init:")));
  sequence.increment(1);
}

// Authority registers a new candidate commitment without revealing identity
export circuit register(commitment: Bytes<32>): [] {
  const sk = localSecretKey();
  const seq = sequence as Field as Bytes<32>;
  assert(authority == publicKey(sk, seq), "Not authorized as authority");
  candidateCount.increment(1);
  sequence.increment(1);
}

// Candidate generates proof of valid registration anonymously
export circuit proveRegistered(): Bytes<32> {
  const sk = localSecretKey();
  const seq = sequence as Field as Bytes<32>;
  const proof = disclose(publicKey(sk, seq));
  return proof;
}

// Deterministic key derivation circuit
export circuit publicKey(sk: Bytes<32>, seq: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "nighthire:pk:"), seq, sk]);
}
